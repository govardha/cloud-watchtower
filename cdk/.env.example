# ---------------------------------------------------------------------------
# cloud-watchtower — optional environment overrides.
#
# NOTE: account IDs + org id already live in cdk.json `context` (super-fiesta
# style), so a .env is NOT required. This file exists only for values you'd
# rather not commit, or to override the committed context locally.
#
# These are AWS ACCOUNT IDs (not secrets) from `aws organizations list-accounts`.
# NEVER put access keys / secrets here — SSO profiles handle auth.
# ---------------------------------------------------------------------------

# Which account/side to synth (logarchive | sandbox | development | production)
WATCHTOWER_ACCOUNT=logarchive

# Org account IDs (optional; cdk.json context is the source of truth)
LOGARCHIVE_ACCOUNT_ID=766997230140
AUDIT_ACCOUNT_ID=698777852125
DEPLOYMENT_ACCOUNT_ID=766789219588
SANDBOX_ACCOUNT_ID=621648307412
DEVELOPMENT_ACCOUNT_ID=304232106942
PRODUCTION_ACCOUNT_ID=953293104741

# Org ID for the bucket-policy aws:PrincipalOrgID condition
ORG_ID=o-x82cglkqhs
